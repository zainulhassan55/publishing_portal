{
  "name": "publishing_portal",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/lib/**/*.test.ts\"",
    "harvest": "node --experimental-strip-types scripts/harvest.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "spike": "node --experimental-strip-types scripts/ojs-spike.ts",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "mysql2": "^3.15.3",
    "next": "^16.4.0",
    "nodemailer": "^10.0.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.4.0",
    "typescript": "~6.0.2"
  },
  "type": "module"
}
