# Copy to .env.local for development. Production values live on the VPS, never
# in the repo — see docs/GO-LIVE.md (this server has no root, so they go in
# ~/portal/.env read by PM2, not a systemd EnvironmentFile).
#
# .env.local is read by `next dev` AND by the standalone scripts
# (`npm run spike`, `harvest`, `db:migrate`) via scripts/env.ts, so setting
# OJS_BASE_URL here once saves prefixing every command. Real environment
# variables always override it.
#
# .env.local is gitignored. Never commit it.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin. Used for canonical URLs, sitemap, JSON-LD and citation meta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Crossref DOI prefix for this publisher.
NEXT_PUBLIC_DOI_PREFIX=10.63521

# ---------------------------------------------------------------------------
# OJS
# ---------------------------------------------------------------------------
# Path OJS is mounted at on the same origin. Same-origin is what makes session
# auth possible; do not point this at another host.
NEXT_PUBLIC_OJS_PATH=/ojs

# Absolute base for server-side calls (harvest, session check, BFF proxy).
# Leave empty locally to run the portal with OJS integration disabled — every
# feature that needs it degrades to a link-out rather than erroring.
OJS_BASE_URL=

# Admin-scoped OJS API key. Server-side only; never prefix this NEXT_PUBLIC_.
#
# OJS 3.5 requires a token for EVERY /api/v1 read, including public data, so
# without this the harvest runs at OAI-PMH fidelity only. Note that the key is
# also useless until `api_key_secret` is set in config.inc.php — OJS cannot
# validate any token without it. `npm run spike` tells you which is wrong.
OJS_API_KEY=

# OJS session cookie name, if changed from the default in config.inc.php.
OJS_SESSION_COOKIE=OJSSID

# Where the harvest snapshot lives. Leave empty locally: the build and `npm run
# harvest` use content/harvest.json. On the server set it to a file OUTSIDE the
# release directory, e.g. /home/nextgeniqpress/portal/shared/harvest.json, so
# the scheduled harvest (deploy/harvest.sh) writes one file that every release
# reads, and a deploy never resets the site to the developer's snapshot.
HARVEST_PATH=

# Shared secret for POST /api/revalidate, which the scheduled harvest and the
# deploy script call to make the running site re-read its content. Any long
# random string; `openssl rand -hex 32` is fine. Without it the site still
# refreshes, but on its own timer (an hour) rather than on the next request.
PORTAL_REVALIDATE_SECRET=

# In-portal sign-in. Off until the auth spike passes: OJS 3.5 has no login API,
# so the portal has to drive its web login handler, and that is the one
# genuinely undocumented part of the integration. While this is 0, the sign-in
# page links out to OJS instead, which always works.
PORTAL_NATIVE_SIGNIN=0

# ---------------------------------------------------------------------------
# OJS spike (scripts/ojs-spike.ts — diagnostic, never in CI)
# ---------------------------------------------------------------------------
# A throwaway OJS account with the Author role on one journal. Used only by
# `npm run spike` to settle whether the login relay works. Never a real user's
# credentials, and never set in production.
OJS_SPIKE_USER=
OJS_SPIKE_PASS=

# ---------------------------------------------------------------------------
# Portal database
# ---------------------------------------------------------------------------
# Separate database in the MySQL instance OJS already uses, with its own user.
# Never point this at the OJS database: the portal must not write OJS tables.
PORTAL_DATABASE_URL=mysql://portal:password@127.0.0.1:3306/portal

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Portal mail only (proposal acknowledgements, alert confirmations, contact
# relay). Peer-review mail is sent by OJS and configured in config.inc.php.
#
# Audit finding F-07: DKIM was not enabled, so review invitations were filtered
# as spam and the editorial process stalled silently. SPF, DKIM and DMARC must
# all pass for this sender before relying on any of it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NextGenIQ Press <no-reply@nextgeniqpress.com>
EDITORIAL_INBOX=contact@nextgeniqpress.com

# ---------------------------------------------------------------------------
# File storage (editorial forms)
# ---------------------------------------------------------------------------
# CVs, proposals and book manuscripts sent through the portal's forms go to
# S3-compatible object storage: Cloudflare R2 in production (two private
# buckets, see docs/CONTENT-RESTRUCTURE-PLAN.md). Journal manuscripts never come
# here; they are OJS's.
#
# Leave these empty to run without uploads: the forms then answer 503 with the
# editorial email address instead of failing silently. `npm run storage:check`
# uploads, reads back and deletes a test file to confirm the keys work.
#
# The access key pair is an R2 "Account API token" with Object Read & Write on
# the two buckets only. Server-side; never prefix NEXT_PUBLIC_.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_SUBMISSIONS=ngiq-submissions
S3_BUCKET_PUBLICATIONS=ngiq-publications

# Cloudflare Turnstile, the captcha on sign-in and register (src/lib/captcha.ts).
# Create a widget at Cloudflare dashboard → Turnstile, mode "Managed", with the
# site's hostname (and localhost for development). Set both or neither: with
# both empty the widget is hidden and the check skipped.
#
# The site key is public and is baked into the browser bundle at build time,
# so it must be present when `next build` runs, not only at start.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
